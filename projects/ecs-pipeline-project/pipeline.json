{
  "pipeline": {
    "name": "ecs-demo-app-pipeline",
    "roleArn": "arn:aws:iam::660235343407:role/ecsDemoCodePipelineRole",
    "artifactStore": { "type": "S3", "location": "ecs-demo-pipeline-artifacts-660235343407" },
    "stages": [
      {
        "name": "Source",
        "actions": [{
          "name": "Source",
          "actionTypeId": {"category":"Source","owner":"AWS","provider":"CodeStarSourceConnection","version":"1"},
          "configuration": {
            "ConnectionArn": "arn:aws:codestar-connections:us-east-1:660235343407:connection/48707859-0059-44ec-8f44-cc6cc0b1407f",
            "FullRepositoryId": "Lifevs/aws-engineering-journey",
            "BranchName": "main"
          },
          "outputArtifacts": [{"name": "SourceOutput"}]
        }]
      },
      {
        "name": "Build",
        "actions": [{
          "name": "Build",
          "actionTypeId": {"category":"Build","owner":"AWS","provider":"CodeBuild","version":"1"},
          "configuration": {"ProjectName": "ecs-demo-app-build"},
          "inputArtifacts": [{"name": "SourceOutput"}],
          "outputArtifacts": [{"name": "BuildOutput"}]
        }]
      },
      {
        "name": "Deploy",
        "actions": [{
          "name": "Deploy",
          "actionTypeId": {"category":"Deploy","owner":"AWS","provider":"ECS","version":"1"},
          "configuration": {
            "ClusterName": "ecs-demo-cluster",
            "ServiceName": "ecs-demo-app-service",
            "FileName": "imagedefinitions.json"
          },
          "inputArtifacts": [{"name": "BuildOutput"}]
        }]
      }
    ]
  }
}
